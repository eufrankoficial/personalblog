<!DOCTYPE html>
<html lang="{{ page.lang }}">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1><a class="site-title" href="/{{ lang }}/">{{ "siteTitle" | t(lang, page) }}</a></h1>
    <nav>
      <a href="/{{ lang }}/">{{ "home" | t(lang, page) }}</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>{{ "footer" | t(page.lang, page) }}</p>
  </footer>
</body>
</html>
